# Google Cloud OAuth client (Desktop app type)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in automatically by `npm run auth:gmail` after you complete the browser consent flow once
GOOGLE_REFRESH_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI fallback parser (used only when no regex parser matches an email).
# Groq has a free tier and is preferred if both are set. Anthropic is paid, optional.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
